{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    "schedule:earlyMondays"
  ],
  "timezone": "Europe/Berlin",
  "automerge": false,
  "ignoreTests": true,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/hotio/**"],
      "versionCompatibility": "^(?<compatibility>.*)-(?<version>.*)$"
    },
    {
      "groupName": "docker-digest",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Traefik Plugins in CLI Format",
      "managerFilePatterns": ["/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)\\s.+?\"--experimental\\.plugins\\..+?\\.version=(?<currentValue>.+?)\""
      ]
    }
  ]
}
